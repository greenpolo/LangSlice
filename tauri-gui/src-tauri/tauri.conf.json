{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LangSlice",
  "version": "0.1.0",
  "identifier": "com.langslice.gui",
  "build": {
    "frontendDist": "../../web-demo/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "cwd": "../../web-demo",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../web-demo",
      "script": "pnpm install && pnpm build"
    }
  },
  "app": {
    "windows": [
      {
        "title": "LangSlice",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$APPDATA/**",
          "$LOCALDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/litert-lm"
    ],
    "resources": [
      "binaries/dxcompiler.dll",
      "binaries/dxil.dll",
      "binaries/libGemmaModelConstraintProvider.dll",
      "binaries/libLiteRt.dll",
      "binaries/libLiteRtTopKWebGpuSampler.dll",
      "binaries/libLiteRtWebGpuAccelerator.dll",
      "binaries/litert-lm.dll"
    ]
  }
}
