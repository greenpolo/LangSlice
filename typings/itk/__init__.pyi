"""ITK-Elastix as LangSlice calls it: the names taken from ``itk``."""

from collections.abc import MutableMapping
from typing import Self

import numpy as np
import numpy.typing as npt

__version__: str

ParameterMap = MutableMapping[str, tuple[str, ...]]

class Image:
    def SetSpacing(self, spacing: list[float], /) -> None: ...
    def SetOrigin(self, origin: list[float], /) -> None: ...

class MultiThreaderBase:
    @staticmethod
    def GetGlobalDefaultNumberOfThreads() -> int: ...
    @staticmethod
    def SetGlobalDefaultNumberOfThreads(count: int, /) -> None: ...

class ParameterObject:
    @classmethod
    def New(cls) -> Self: ...
    def GetDefaultParameterMap(self, name: str, /) -> ParameterMap: ...
    def AddParameterMap(self, parameter_map: ParameterMap, /) -> None: ...
    def GetParameterMap(self, index: int, /) -> ParameterMap: ...
    def GetNumberOfParameterMaps(self) -> int: ...

class ElastixRegistrationMethod:
    @classmethod
    def New(cls, fixed: Image, moving: Image, /) -> Self: ...
    def SetFixedMask(self, mask: Image, /) -> None: ...
    def SetMovingMask(self, mask: Image, /) -> None: ...
    def AddFixedImage(self, image: Image, /) -> None: ...
    def AddMovingImage(self, image: Image, /) -> None: ...
    def AddFixedMask(self, mask: Image, /) -> None: ...
    def AddMovingMask(self, mask: Image, /) -> None: ...
    def SetParameterObject(self, parameters: ParameterObject, /) -> None: ...
    def SetLogToConsole(self, on: bool, /) -> None: ...
    def UpdateLargestPossibleRegion(self) -> None: ...
    def GetTransformParameterObject(self) -> ParameterObject: ...

def image_from_array(array: npt.NDArray[np.generic], /) -> Image: ...
