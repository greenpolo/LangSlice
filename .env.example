# Backend selection: ai_studio | vertex_api_key | vertex_adc
LANGSLICE_GENAI_BACKEND=ai_studio

# AI Studio (Gemini Developer API)
GEMINI_API_KEY=your_ai_studio_key_here

# Vertex AI API key mode (Express)
GOOGLE_CLOUD_API_KEY=your_vertex_api_key_here

# Vertex AI ADC mode (service account / gcloud auth)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
